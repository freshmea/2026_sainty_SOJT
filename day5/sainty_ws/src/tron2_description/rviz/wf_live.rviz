Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: ["/TRON2 WF1", "/TF1"]
Visualization Manager:
  Global Options:
    Fixed Frame: world
    Background Color: 55; 62; 72
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.15
      Plane Cell Count: 14
      Offset: {X: 0, Y: 0, Z: 0}
    - Class: rviz_default_plugins/RobotModel
      Name: TRON2 WF
      Enabled: true
      TF Prefix: tron2
      Description Source: Topic
      Description Topic:
        Value: /tron2/robot_description
        Reliability Policy: Reliable
        Durability Policy: Transient Local
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Marker Scale: 0.35
      Show Names: false
      Show Axes: true
      Show Arrows: false
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Target Frame: tron2/base_Link
      Distance: 2.38
      Pitch: 0.25
      Yaw: 0.9
      Focal Point: {X: 0, Y: 0, Z: 0}
