<mujoco model="one_joint_arm">
  <compiler angle="radian"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>
  <visual><global offwidth="960" offheight="640"/></visual>
  <worldbody>
    <light pos="0 -2 4"/>
    <geom name="floor" type="plane" size="2 2 0.1" rgba="0.23 0.3 0.4 1"/>
    <body name="base" pos="0 0 0.5">
      <geom type="cylinder" size="0.07 0.05" rgba="0.5 0.6 0.7 1" contype="0" conaffinity="0"/>
      <body name="link">
        <joint name="hinge" type="hinge" axis="0 0 1" damping="0.1"/>
        <geom name="arm_geom" type="capsule" fromto="0 0 0 0.4 0 0" size="0.025" mass="0.5" rgba="0.1 0.7 0.65 1"/>
        <site name="tip" pos="0.4 0 0" size="0.04" rgba="1 0.6 0.1 1"/>
      </body>
    </body>
  </worldbody>
  <actuator>
    <motor name="motor" joint="hinge" gear="1" ctrllimited="true" ctrlrange="-2 2"/>
  </actuator>
  <sensor>
    <jointpos name="angle" joint="hinge"/>
    <jointvel name="speed" joint="hinge"/>
  </sensor>
</mujoco>
